# Secrets : ne JAMAIS envoyer sur GitHub
.env

# Base de données locale (recréée par : python -m tracewatch.db)
*.db
*.sqlite
*.sqlite3

# Cache LLM de travail (le cache de la démo, lui, est dans data/demo/ et EST versionné)
data/cache_llm/*
!data/cache_llm/.gitkeep

