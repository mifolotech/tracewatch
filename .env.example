# Modèle du fichier .env : AUCUN secret ici.
# Copier ce fichier en .env puis remplir les valeurs. Le .env reste sur ta machine.

# Fournisseur LLM : gemini (seul fournisseur branché). Pour en ajouter un autre (Groq,
# Anthropic, modèle local), voir src/tracewatch/analyse/llm_client.py
LLM_PROVIDER=gemini

# Clé Gemini (https://aistudio.google.com/apikey). Vide = mode démo avec le cache.
GEMINI_API_KEY=

# Optionnel : jeton GitHub (lecture seule) pour dépasser la limite de 60 requêtes/heure
GITHUB_TOKEN=

# Optionnel : clé gratuite OpenAlex (https://openalex.org/settings/api)
# Sans clé, le budget quotidien gratuit est partagé avec tout ton réseau.
OPENALEX_API_KEY=
OPENALEX_EMAIL=

# Optionnel : autre emplacement pour la base (par défaut data/tracewatch.db)
TRACEWATCH_DB=
